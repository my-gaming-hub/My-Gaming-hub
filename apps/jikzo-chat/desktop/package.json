{
  "name": "nexora-desktop",
  "version": "0.2.0",
  "description": "Nexora for Windows 7 and later",
  "main": "electron/main.js",
  "author": "JIKZO Creative",
  "license": "UNLICENSED",
  "scripts": {
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "23.6.0"
  },
  "build": {
    "appId": "com.jikzocreative.jikzochat",
    "productName": "Nexora",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/main.js",
      "web-dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64"
          ]
        }
      ],
      "artifactName": "Nexora-Setup-${arch}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
